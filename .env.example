# Oppsettet for én instans. Kopier til .env (eller .env.<navn> for flere instanser på samme PC, og start
# med python3 refine.py --env .env.<navn>). Verdiene kan også settes som vanlige miljøvariabler; de går foran.
# Se README, «Koble til dine systemer».

# --- Notion (påkrevd) ---
# Nøkkel til en Notion-integrasjon med tilgang til boardet (••• → Connections på boardsiden)
NOTION_API_KEY=ntn_...
# Siden som har oppgaveboardet
NOTION_BOARD=https://www.notion.so/<arbeidsområde>/<side>-<id>

# --- Kode (påkrevd: GITHUB_REPO eller CODE_LOCAL) ---
# Repoet agentene leser og bygger i. Git bruker din egen innlogging (samme som git clone), ingen nøkkel her.
GITHUB_REPO=https://github.com/<org>/<repo>
GITHUB_BRANCH=main
# Eller bare les en lokal mappe (raffinering uten utvikling):
# CODE_LOCAL=../mitt-prosjekt

# --- Figma (valgfritt) ---
# Produktets Figma-fil. Agenten blar i den etter frames og tegner skisser på siden «🤖 Skisser».
FIGMA_FILE=https://www.figma.com/design/<nøkkel>/<navn>
# Personlig nøkkel, så frames lastes opp som bilder i Slack i stedet for lenker
FIGMA_TOKEN=

# --- Slack (valgfritt) ---
# Bot User OAuth Token og App-Level Token (connections:write)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Kanal-ID-en broen bruker (nederst i kanalens detaljer). Inviter boten: /invite @Raffineringsagent
SLACK_CHANNEL=C0123ABC
# Bare for testing: alle oppgaver fra /new får denne Notion-brukeren som Eier
SLACK_TEST_OWNER=

# --- Instansen (valgfritt) ---
# Navnet andre instanser ser i Notion («Agent»). Standard er PC-navnet. Må være unikt blant PC-ene som deler boardet.
INSTANCE_NAME=
