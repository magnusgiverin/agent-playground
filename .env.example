# Hemmelighetene. Alt annet ligger i refiner.toml.
# Nøkkel til en Notion-integrasjon med lese- og skrivetilgang til boardet (Connections på boardsiden)
NOTION_API_KEY=ntn_...

# Slack (valgfritt): Bot User OAuth Token og App-Level Token (connections:write), se README
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Figma (valgfritt): personlig nøkkel, så Figma-frames lastes opp som bilder i Slack i stedet for lenker
FIGMA_TOKEN=
